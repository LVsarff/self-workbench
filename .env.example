# —— 数据库（docker compose up -d 后按默认即可）——
DATABASE_URL=postgres://gwd:gwd@localhost:5432/gwd

# —— Redis（定时任务 schedule 用）——
REDIS_URL=redis://localhost:6379

# —— LLM（不配置则自动降级为模板理由，流水线照常完成）——
OPENAI_API_KEY=
GWD_LLM_MODEL=gpt-4o-mini
GWD_LLM_BUDGET_CALLS_PER_DAY=50

# —— API 服务 ——
PORT=8787
# 默认只监听本机（127.0.0.1）。要暴露到内网必须同时配置下面的 token：
# HOST=0.0.0.0
# API 鉴权 token（配置后所有 /api/* 请求需带 x-api-token 头；web 端用 NEXT_PUBLIC_API_TOKEN 同值配置）
# GWD_API_TOKEN=换一个足够长的随机串
