# —— 数据库（docker compose up -d 后按默认即可）——
DATABASE_URL=postgres://gwd:gwd@localhost:5432/gwd

# —— Redis（定时任务 schedule 用）——
REDIS_URL=redis://localhost:6379

# —— LLM（不配置 key 则自动降级为模板理由，流水线照常完成）——
# 默认走 OpenAI 官方端点；要切 DeepSeek 等 OpenAI 兼容服务，配 OPENAI_BASE_URL + 换模型名即可：
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1        # DeepSeek（也可不写 /v1）
GWD_LLM_MODEL=gpt-4o-mini                             # DeepSeek: deepseek-chat（非推理）/ deepseek-reasoner（推理）
GWD_LLM_BUDGET_CALLS_PER_DAY=50

# —— API 服务 ——
PORT=8787
# 默认只监听本机（127.0.0.1）。要暴露到内网必须同时配置下面的 token：
# HOST=0.0.0.0
# API 鉴权 token（配置后所有 /api/* 请求需带 x-api-token 头；web 端用 NEXT_PUBLIC_API_TOKEN 同值配置）
# GWD_API_TOKEN=换一个足够长的随机串
